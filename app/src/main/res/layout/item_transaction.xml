<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="16dp"
    android:layout_marginEnd="16dp"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp"
        android:gravity="center_vertical">

        <!-- Transaction Icon -->
        <FrameLayout
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp">

            <View
                android:id="@+id/icon_background"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:background="@drawable/circle_background"
                android:backgroundTint="#E1BEE7"/>

            <ImageView
                android:id="@+id/icon_transaction_type"
                android:layout_width="48dp"
                android:layout_height="36dp"
                android:layout_gravity="center"
                android:src="@drawable/person_outline"
                app:tint="#673AB7" />
        </FrameLayout>

        <!-- Transaction Details -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_receiver"
                android:text="receiver@upi"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A" android:layout_height="50dp" android:layout_width="100dp"/>

            <TextView
                android:id="@+id/text_timestamp"
                android:text="Dec 15, 2025 • 10:00 AM"
                android:textSize="13sp"
                android:textColor="#6B7280"
                android:layout_marginBottom="4dp" android:layout_height="50dp" android:layout_width="100dp"/>

            <!-- Status -->
            <TextView
                android:id="@+id/text_status"
                android:text="Approved"
                android:textSize="11sp"
                android:textStyle="bold"
                android:textColor="#10B981"
                android:background="#2200FF00"
                android:padding="6dp" android:layout_height="30dp" android:layout_width="70dp"/>

            <!-- ✅ CATEGORY (NEW) -->
            <TextView
                android:id="@+id/text_category"
                android:text="FOOD"
                android:textSize="12sp"
                android:textColor="#6B7280"
                android:layout_marginTop="4dp" android:layout_height="20dp" android:layout_width="50dp"/>
        </LinearLayout>

        <!-- Amount -->
        <TextView
            android:id="@+id/text_amount"
            android:text="₹ 100.00"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#DC2626"
            android:layout_marginStart="12dp" android:layout_height="50dp" android:layout_width="100dp"/>
    </LinearLayout>
</androidx.cardview.widget.CardView>
